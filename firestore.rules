rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasAccess() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/access/$(request.auth.token.email));
    }
    function role() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.role;
    }
    function isAdmin()  { return hasAccess() && role() == 'Admin'; }
    function canEdit()  { return hasAccess() && (role() == 'Admin' || role() == 'Editor'); }

    // Access list: users read their own record; only Admins read the full list and manage it.
    match /access/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // Leave data: any approved user can view; Admin and Editor can save.
    match /holiday/{doc} {
      allow read: if hasAccess();
      allow write: if canEdit();
    }
  }
}
