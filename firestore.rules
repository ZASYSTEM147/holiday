rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/access/$(uid)).data;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && userDoc(request.auth.uid).active == true
        && userDoc(request.auth.uid).role in ['Admin', 'Editor', 'Viewer'];
    }
    function isAdmin() {
      return activeUser() && userDoc(request.auth.uid).role == 'Admin';
    }
    function canEdit() {
      return activeUser() && userDoc(request.auth.uid).role in ['Admin', 'Editor'];
    }

    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /accessRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    match /appData/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if canEdit() && docId == 'main';
    }
  }
}
